# AgentCity environment template.
# M0 note: no application code reads this file yet; it records the M1 contract.
# Copy to .env for local development. Never commit .env.
# In production, secrets belong in the OS credential store, not this file.

# --- AgentCity ---------------------------------------------------------------
AGENTCITY_ENV=development
AGENTCITY_LOG_LEVEL=info
# 0 selects a free loopback port; the desktop shell reads the actual port from
# the sidecar handshake file.
AGENTCITY_API_PORT=0
# Overrides the app-owned data directory. Default: %LOCALAPPDATA%\AgentCity
# AGENTCITY_HOME=

# --- Model providers ---------------------------------------------------------
# Required for live ADK runs. Leave empty to use Offline Mode.
GEMINI_API_KEY=
# Optional fallback providers (only used when an adapter is implemented).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Skills Bridge -----------------------------------------------------------
# Repository root of the vendored SkillBridge checkout. The importable package
# root is <SKILLBRIDGE_PATH>\src.
SKILLBRIDGE_PATH=src/skills/skills-bridge
# Defaults to the real catalog at ~/.skillbridge. Never point development or
# tests at a corrupt catalog; override with a throwaway directory and pass
# --home as well. See docs/runbooks/mcp-and-skills.md.
# SKILLBRIDGE_HOME=

# --- Desktop and voice -------------------------------------------------------
# Screen capture stays off until the user grants permission in the UI.
AGENTCITY_DESKTOP_CAPTURE=off
# Wake word is opt-in and disabled by default.
AGENTCITY_WAKE_WORD=off
